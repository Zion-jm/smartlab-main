{
  "name": "smartlab-workspace",
  "version": "1.0.0",
  "description": "SmartLab - Laboratory Management System Workspace",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "start": "cd backend && npm run start",
    "db:generate": "cd backend && npm run db:generate",
    "db:migrate": "cd backend && npm run db:migrate",
    "db:push": "cd backend && npm run db:push",
    "db:seed": "cd backend && npm run db:seed",
    "install:all": "npm ci",
    "clean": "rm -rf backend/node_modules frontend/node_modules backend/dist frontend/dist",
    "db:deploy": "npm run db:deploy --workspace=backend",
    "db:status": "npm run db:status --workspace=backend",
    "start:production": "node backend/scripts/start-production.cjs",
    "test:regression": "node backend/scripts/test-regression.cjs",
    "lint:ci": "node scripts/lint-strict.cjs",
    "test:ui": "node scripts/test-ui.cjs"
  },
  "keywords": [
    "smartlab",
    "workspace",
    "monorepo"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "playwright": "1.58.2"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10 <11"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.3.2"
    }
  }
}
