# Copy to backend/.env for local development; never commit real values.
DATABASE_URL="postgresql://postgres:REPLACE_WITH_URL_ENCODED_PASSWORD@localhost:5432/smartlab_test?schema=public"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5000

# Optional email. Delivery is disabled when SMTP_PASS is empty.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SmartLab <no-reply@example.invalid>"

# Optional PDF browser executable; configure for your operating system.
# CHROMIUM_PATH=

# Demo seeding requires explicit temporary shell variables; see docs/local-development.md.
# Do not leave ALLOW_DEMO_SEED enabled in saved application settings.

# Production: exact HTTPS FRONTEND_URL origin, private/random JWT_SECRET (32+ chars).
# Run reviewed migrations before startup. See docs/production-deployment.md.

# Optional additional exact frontend origins, comma separated (no wildcard).
CORS_ORIGINS=
# Set only to the real reverse proxy IP/subnets; blank uses socket IP.
TRUSTED_PROXIES=
